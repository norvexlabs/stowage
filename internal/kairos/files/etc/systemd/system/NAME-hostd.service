[Unit]
Description={{.Name}}: host daemon ({{.Ctl}}'s verbs on this VM)
# The installer ISO boots this system live, to install it: no host of the stack.
ConditionPathExists=!/run/cos/live_mode
Wants=docker.service
# After the cloud-config's boot stage, whose load of the firewall takes no lock: a change of SSH's
# sources the daemon makes is never loaded over by it.
After=docker.service cos-setup-boot.service

[Service]
ExecStart=/usr/sbin/{{.Ctl}} hostd
Restart=always
RestartSec=2
# A backup cut off by a stop cleans up first (up to 5 min 45 s: the daemon's backupStopWait).
TimeoutStopSec=7min

[Install]
WantedBy=multi-user.target

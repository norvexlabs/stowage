# Not enabled: the host daemon starts it once backup settings exist, on their schedule.
[Unit]
Description={{.Name}}: the scheduled backup's timer (`{{.Ctl}} backup config --schedule` moves it)

[Timer]
OnCalendar=*-*-* 03:00:00 UTC
RandomizedDelaySec=15min
# A run missed while the VM was off runs once it is up.
Persistent=true

[Unit]
Description={{.Name}}: tune the network for this boot's RAM and CPUs, before the network and Docker start
DefaultDependencies=no
After=local-fs.target systemd-udevd.service systemd-udev-trigger.service systemd-sysctl.service systemd-modules-load.service
Before=network-pre.target systemd-networkd.service docker.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/{{.Ctl}} tune-boot

[Install]
WantedBy=multi-user.target

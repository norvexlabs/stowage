[Unit]
Description={{.Name}}: grow the persistent partition to fill the disk
# The installer ISO boots this system live, to install it: no host of the stack.
ConditionPathExists=!/run/cos/live_mode
After=local-fs.target
Before={{.Name}}-preload.service docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/kairos-agent run-stage {{.Name}}.expand
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target

# syntax=docker/dockerfile:1
#
# The OS bundle of {{.Name}}: a plain distribution converted into a bootable Kairos image by
# kairos-init (no Kubernetes provider), with Docker running the stack and the release's images
# preloaded. Rendered and built by `stowage ship`.
{{/* purge removes the packages of the list that are installed: one kairos-init no longer installs
is absent already, and apt refuses a name it does not know. */}}{{define "purge"}}p="$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n'{{range .}} {{.}}{{end}} 2>/dev/null | awk '$1 ~ /^i/ {print $2}')"; \
    [ -z "$p" ] || apt-get purge -y $p{{end}}

FROM {{.KairosInit}} AS kairos-init

FROM {{.Base}} AS image

# The build takes Ubuntu alone: its package names, Docker's repository and the purge below are
# Ubuntu's. Guest agents: kairos-init only starts them, on the hypervisor its DMI check matches.
# tzdata-legacy (the zones' old names, e.g. US/Eastern) where the base has it.
RUN . /etc/os-release && { [ "$ID" = ubuntu ] || { echo "shapes.kairos.base: $PRETTY_NAME: the OS bundle's build takes Ubuntu" >&2; exit 1; }; } \
    && apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl ethtool gnupg jq nftables open-vm-tools qemu-guest-agent tzdata \
        $(apt-cache show tzdata-legacy >/dev/null 2>&1 && echo tzdata-legacy) \
    && rm -rf /var/lib/apt/lists/*

# The install stage writes the version nowhere (the init stage does, below). This stage is never
# served from the build cache: each build installs the packages the archive holds then (the
# kernel's and Docker's security updates among them).
COPY --from=kairos-init /kairos-init /kairos-init
RUN /kairos-init -s install -v 0.0.0

{{with .PurgeBeforeInit}}# kairos-init installs one package list on every Debian-family image; what the bundle does without
# goes before its init stage, so the initrd that stage builds carries none of it. multipath-tools
# stays: the init stage adds dracut's multipath module, which needs it (its daemon is masked).
RUN {{template "purge" .}}; \
    apt-get autoremove -y --purge

{{end}}# Docker engine and the compose plugin, from Docker's apt repository.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && . /etc/os-release \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu ${VERSION_CODENAME} stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Docker keeps its data on the persistent partition (/usr/local), so images and containers survive
# an A/B upgrade, and starts after nftables, whose ruleset flush would drop Docker's chains.
RUN mkdir -p /etc/docker /usr/lib/systemd/system/docker.service.d \
    && printf '{\n  "data-root": "/usr/local/docker",\n  "features": {"containerd-snapshotter": true}\n}\n' > /etc/docker/daemon.json \
    && printf '[Unit]\nAfter=nftables.service\nWants=nftables.service\n' > /usr/lib/systemd/system/docker.service.d/10-{{.Name}}-after-nftables.conf

# Everything the image adds lives outside /usr/local, /var, /oem, /opt and /home: Kairos mounts
# persistent storage there, which would hide it. Its units, their drop-ins and the links enabling
# them live in /usr/lib, never in /etc/systemd or /etc/ssh: those are Kairos's persistent state,
# which every boot fills from its image without deleting or overwriting a newer file, so a file
# there outlives the release that shipped it and reaches an older one after a rollback
# (files/system/oem/02_NAME_retire.yaml parks the copies earlier bundles left there). The alias
# and the mask below stay in /etc: each takes the name of its package's unit in /usr/lib, and is
# the same in every release.
COPY files/ /
RUN chmod 0440 /etc/sudoers.d/10-{{.Name}} \
    && chmod 0755 /usr/sbin/{{.Name}}-preload \
    && mkdir -p /etc/{{.Name}} \
    && echo "{{.OSVersion}}" > /etc/{{.Name}}/os-version \
    && w=/usr/lib/systemd/system/multi-user.target.wants && mkdir -p $w /usr/lib/systemd/system/getty.target.wants \
    && (getent group admin >/dev/null || groupadd --system admin) \
    && for u in{{range .Enabled}} {{.}}{{end}} docker.service nftables.service; do \
           ln -sf /usr/lib/systemd/system/$u $w/$u; done \
    && ln -sf /usr/lib/systemd/system/serial-getty@.service /usr/lib/systemd/system/getty.target.wants/serial-getty@ttyS0.service \
    && ln -sf /usr/lib/systemd/system/open-vm-tools.service /etc/systemd/system/vmtoolsd.service \
    && ln -sf /dev/null /etc/systemd/system/multipathd.service

# The release's images, as archives `docker load` reads at every boot.
COPY preload/ /usr/share/{{.Name}}-preload/

# {{.Ctl}}, carrying the release: it installs it, brings it up at every boot and runs the host
# daemon.
COPY --chmod=0755 ctl/{{.Ctl}} /usr/sbin/{{.Ctl}}

# dracut's crypt generator, which the init stage puts in the initrd, ends with `return` outside
# a function when no disk is encrypted, which sh refuses (exit 2): every boot would log its
# failure. Its returns become exits, before the initrd is built; the build fails when the script
# no longer reads as expected.
RUN set -e; f=/usr/lib/dracut/modules.d/70crypt/crypt-generator.sh; \
    grep -qxF '[ -e /etc/crypttab ] || return 0' "$f"; \
    [ "$(grep -cw return "$f")" = 3 ]; \
    sed -i 's/\breturn \([0-9]\)$/exit \1/' "$f"; \
    if grep -qw return "$f"; then echo "shapes.kairos.kairos_init: its $f keeps a return outside a function: use kairos-init v4.6.0" >&2; exit 1; fi; \
    sh -n "$f"

# kairos-init's init stage strips the kernel modules; without them netfilter, and so nftables and
# Docker, fail. They are reinstalled, and the build fails if they did not come back. Its CIS
# hardening step is skipped: its shell umask (027) would leave the files an operator's run
# writes unreadable to a stack's non-root containers, and its password ageing and lockout apply
# to the operator's account. Its SSH hardening stays; the build fails without its drop-in. The
# drop-in moves to this image's /usr, read through an Include: /etc/ssh is persistent state,
# which every boot fills from its image without deleting, so a file left there by a newer image
# would reach an older one's sshd on a rollback, which refuses settings it does not know and
# does not start. On a system without that directory the Include reads nothing. The image's own
# settings sit beside it (files/usr/lib/NAME/sshd_config.d): those that differ from the drop-in's
# named to be read first (sshd keeps a keyword's first value): root's login refused, where the
# drop-in allows it by key, as a cloud's datasource writes its metadata's SSH keys (on Scaleway,
# every key of the project) for root; the login by key alone, which the drop-in leaves unset,
# after it. The build fails, naming the check, when sshd's effective settings are not these.
RUN set -e; fail() { echo "os bundle: $*" >&2; exit 1; }; \
    /kairos-init -s init --skip-step cisHardening -v "{{.OSVersion}}"; \
    rm /kairos-init; \
    grep -qx 'AllowTcpForwarding no' /etc/ssh/sshd_config.d/05-kairos-hardening.conf \
        || fail "kairos-init wrote no SSH hardening drop-in (/etc/ssh/sshd_config.d/05-kairos-hardening.conf with AllowTcpForwarding no)"; \
    install -d -m 0755 /usr/lib/{{.Name}}/sshd_config.d; \
    mv /etc/ssh/sshd_config.d/05-kairos-hardening.conf /usr/lib/{{.Name}}/sshd_config.d/; \
    printf 'Include /usr/lib/{{.Name}}/sshd_config.d/*.conf\n' > /etc/ssh/sshd_config.d/00-{{.Name}}-hardening.conf; \
    k="$(mktemp -d)"; ssh-keygen -q -t ed25519 -N '' -f "$k/key"; mkdir -p /run/sshd; \
    sshd -T -h "$k/key" > "$k/effective" || fail "sshd -T refuses the image's SSH settings"; \
    for s in 'permitrootlogin no' 'allowtcpforwarding no' 'maxauthtries 4' 'passwordauthentication no' 'kbdinteractiveauthentication no' 'pubkeyauthentication yes'; do \
        grep -qx "$s" "$k/effective" || fail "sshd's effective setting is '$(grep "^${s%% *} " "$k/effective" || echo "${s%% *} absent")', not '$s'"; done; \
    rm -rf "$k"; \
    ! test -e /etc/modprobe.d/cis-blocklist.conf || fail "kairos-init's CIS module blocklist is installed"; \
    ! grep -rqsE '^[[:space:]]*umask[[:space:]]+0*27([^0-7]|$)' /etc/profile /etc/profile.d /etc/bash.bashrc \
        || fail "kairos-init's CIS shell umask 027 is set (/etc/profile, /etc/profile.d or /etc/bash.bashrc)"; \
    ! grep -qsE '^[[:space:]]*UMASK[[:space:]]+0*27([^0-7]|$)' /etc/login.defs || fail "kairos-init's CIS UMASK 027 is set in /etc/login.defs"; \
    mods="$(dpkg-query -W -f='${Package}\n' 'linux-modules-*' 2>/dev/null | sort -u)"; \
    [ -n "$mods" ] || fail "no linux-modules-* package installed"; \
    apt-get update; \
    apt-get install --reinstall -y --no-install-recommends $mods; \
    rm -rf /var/lib/apt/lists/*; \
    n=$(find /lib/modules/ -name '*.ko*' | wc -l); \
    [ "$n" -ge 100 ] || fail "only $n kernel modules after the reinstall"

# The kairos-init files the bundle edits or relies on, each as kairos-init v4.6.0 writes it, from
# the files it embeds, whatever the base (internal/kairos/testdata holds them, and a test the sums):
# the build fails, naming the file, when one differs, before any step below edits it.
#   /etc/cos/grub.cfg: the entries' ids (cos, fallback, recovery), the fallback's
#     extra_passive_cmdline, next_entry read once into selected_entry, which the bundle's boot
#     assessment reads (files/usr/share/NAME/08_grub.yaml).
#   /etc/cos/bootargs.cfg: its consoles and its last line (setKernelCmd), edited below.
#   /system/oem/00_datasource.yaml: its providers' list, extended below.
#   /system/oem/00_rootfs.yaml: PERSISTENT_STATE_PATHS, /etc/systemd and /etc/ssh among them,
#     where the bundle puts nothing of its own (its units are in /usr/lib).
#   /system/oem/05_network.yaml: 20-dhcp.network and 20-dhcp-legacy.network, which the VM's seed
#     extends, and the network files the seed's sort before.
#   /system/oem/08_grub.yaml: the boot assessment the bundle's copy is derived from.
#   /system/oem/09_systemd_services.yaml: cos-setup-boot and cos-setup-network, which the bundle's
#     units and its host daemon follow; its receive buffer ceiling and iscsid, edited below.
RUN set -e; for p in \
        2305a392d0d6ff6a7ff813e644280e644282efb5c881eeff23e747f176660146:/etc/cos/grub.cfg \
        853c9039b6b992e2f1e4c9110821dc271b145d285e50b178102ff4046d524c66:/etc/cos/bootargs.cfg \
        dc2ad88a597d0431c0bb5a0df4b2808ff0c583a403fca8a0256dde75c9b37083:/system/oem/00_datasource.yaml \
        71a599186fa434cfb514f018d08b39083acb25f54cea427098124f6d49da5d16:/system/oem/00_rootfs.yaml \
        ea498b34897864778ec018a5fb9208dc31f2096e97d8e89f4e3aa36e7e3b2752:/system/oem/05_network.yaml \
        a8d0b7ba11e554651ffaa7ec1cf132b217679be3bc387675ea1ad4ca40d104e5:/system/oem/08_grub.yaml \
        1820acca62043f3257e1f0f0211a86e6784dd2cd3f8d8c90e7e45c10169cb289:/system/oem/09_systemd_services.yaml; do \
        echo "${p%%:*}  ${p#*:}" | sha256sum -c --status - || \
            { echo "shapes.kairos.kairos_init: its ${p#*:} is not the one this stowage relies on: use kairos-init v4.6.0" >&2; exit 1; }; done

# The initrd's network is dropped at switch-root (files/usr/lib/systemd/network): the build fails
# when the initrd the init stage built does not carry dracut's default network, the hook that
# installs it as zzzz-dracut-default.network (which the drop-in extends), or the drop-in.
RUN set -e; fail() { echo "os bundle: $*" >&2; exit 1; }; \
    [ -f /boot/initrd ] || fail "no initrd at /boot/initrd"; \
    lsinitrd /boot/initrd > /tmp/initrd.lst || fail "lsinitrd /boot/initrd"; \
    for f in usr/lib/dracut/dracut-default.network var/lib/dracut/hooks/cmdline/99-networkd-config.sh usr/lib/systemd/network/zzzz-dracut-default.network.d/50-{{.Name}}-initrd.conf; do \
        awk -v f="$f" '{sub(/ -> .*$/, "")} $NF == f {found = 1} END {exit !found}' /tmp/initrd.lst || fail "the initrd does not carry $f: the drop-in dropping the initrd's network at switch-root extends nothing"; done; \
    lsinitrd -f var/lib/dracut/hooks/cmdline/99-networkd-config.sh /boot/initrd | grep -q '/run/systemd/network/zzzz-dracut-default\.network' \
        || fail "the initrd's network hook no longer installs its default network as zzzz-dracut-default.network, which the drop-in extends"; \
    rm /tmp/initrd.lst

# What goes after the init stage: the packages it enables unconditionally, and the timers that
# would upgrade an image-based system in place or fetch Canonical's news (masked). The build fails
# when a purged package is still installed (but those host.packages declares). The project's
# packages (host.packages) come last, after the stage that would strip a kernel module they ship,
# with what they depend on (a purged one included), over the image as the init stage built its
# initrd: the packages the boot and the stack run on are held (those not held already), so apt
# neither upgrades nor removes one for them (one that needs it fails the build), and the build
# fails when they bring a package of that kind (a kernel, its modules, a service of the boot's);
# one declared that is installed already is left as it is.
#
# The clouds' fast NICs, gVNIC (gve) and Azure's MANA, ship in the kernel's extra modules: those two
# are copied from it, not its 110 MB. The build fails when a kernel lacks one, a module the boot's
# tuning loads (TUN devices, the connection tracker, BBR, fq), nftables' socket and TPROXY matches
# (services.<name>.transparent), a server's NIC or disk controller
# a bare-metal install boots with (Intel, Broadcom, Mellanox, Marvell/QLogic, Realtek, NVMe, AHCI,
# LSI/Broadcom MegaRAID and SAS, Microchip, HPE). This step shares its RUN with the project's
# packages: the archive's indexes are fetched once, by whichever needs them first, and only when
# one does.
RUN set -e; fetched={{with .PurgeAfterInit}}; {{template "purge" .}}{{end}}; \
    for u in apt-daily.timer apt-daily-upgrade.timer motd-news.timer; do ln -sf /dev/null /etc/systemd/system/$u; done; \
    for p in{{range .Absent}} {{.}}{{end}}; do \
        if dpkg-query -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null | grep -q '^i'; then echo "the OS bundle has $p, which it purges: host.packages keeps one" >&2; exit 1; fi; done{{with .Packages}}; \
    t="$(mktemp -d)"; dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' | awk '$1 ~ /^i/ {print $2}' > "$t/installed"; \
    apt-mark showhold > "$t/held"; \
    held="$(grep -E '{{$.Held}}' "$t/installed" | grep -vxF -f "$t/held" || true)"; \
    want="$(printf '%s\n'{{range $n, $_ := .}} {{$n}}{{end}} | grep -vxF -f "$t/installed" || true)"; \
    [ -z "$held" ] || printf '%s\n' "$held" | xargs apt-mark hold >/dev/null; \
    if [ -n "$want" ]; then apt-get update; fetched=1; apt-get install -y --no-install-recommends --no-remove $want; fi; \
    new="$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' | awk '$1 ~ /^i/ {print $2}' | grep -E '{{$.Held}}' | grep -vxF -f "$t/installed" || true)"; rm -rf "$t"; \
    [ -z "$new" ] || { echo "host.packages bring packages of the boot's own: $new" >&2; exit 1; }; \
    [ -z "$held" ] || printf '%s\n' "$held" | xargs apt-mark unhold >/dev/null{{end}}; \
    cd /tmp; \
    for k in /lib/modules/*; do v="$(basename "$k")"; \
        if ! modinfo -k "$v" gve >/dev/null 2>&1 || ! modinfo -k "$v" mana >/dev/null 2>&1; then \
            [ -n "$fetched" ] || { apt-get update; fetched=1; }; \
            apt-get download "linux-modules-extra-$v"; dpkg-deb -x linux-modules-extra-"$v"_*.deb /tmp/extra; \
            for m in gve mana; do \
                f="$(find /tmp/extra -path "*/modules/$v/*" -name "$m.ko*" | head -n1)"; \
                if [ -z "$f" ]; then echo "linux-modules-extra-$v has no $m" >&2; exit 1; fi; \
                install -D -m 0644 "$f" "$k/${f#*/modules/$v/}"; done; \
            rm -rf /tmp/extra linux-modules-extra-*.deb; depmod "$v"; fi; \
        for m in tun nf_conntrack tcp_bbr sch_fq nft_socket nft_tproxy gve mana mlx5_core \
            ice i40e ixgbe igb igc e1000e bnxt_en mlx4_en tg3 qede r8169 nvme ahci megaraid_sas mpt3sas smartpqi hpsa; do \
            modinfo -k "$v" "$m" >/dev/null || { echo "kernel $v lacks $m" >&2; exit 1; }; done; done; \
    rm -rf /var/lib/apt/lists/*

{{with .Firmware}}# The firmware files the project's drivers load (host.firmware). The build fails when one is not
# under /lib/firmware, as it is or compressed.
RUN set -e; for f in{{range $p, $_ := .}} {{$p}}{{end}}; do \
        [ -f "/lib/firmware/$f" ] || [ -f "/lib/firmware/$f.zst" ] || [ -f "/lib/firmware/$f.xz" ] || \
            { echo "host.firmware.$f: the OS bundle has no /lib/firmware/$f (nor .zst, .xz): host.packages gives the package that ships it" >&2; exit 1; }; done

{{end}}{{if .Modules}}# The project's kernel modules (host.modules). The build fails when a module to load or
# give options is in no kernel, when one is built into it (modprobe's files do not reach those,
# and tune could not tell one loaded), when an option is not one of the module's parameters, or when
# modprobe does not read the bundle's files.
RUN set -e; for k in /lib/modules/*; do v="$(basename "$k")"; \
{{- range $name, $m := .Modules}}
{{- if or $m.Load $m.Options}}
        modinfo -k "$v" {{$name}} >/dev/null || { echo "host.modules.{{$name}}: kernel $v has no such module" >&2; exit 1; }; \
{{- end}}
        [ "$(modinfo -k "$v" -F filename {{$name}} 2>/dev/null)" != "(builtin)" ] || { echo "host.modules.{{$name}}: built into kernel $v: modprobe's files do not reach it, and it is always there" >&2; exit 1; }; \
{{- range $o, $_ := $m.Options}}
        modinfo -k "$v" -F parm {{$name}} | cut -d: -f1 | grep -qx {{$o}} || { echo "host.modules.{{$name}}.options: {{$o}} is not a parameter of kernel $v's {{$name}}" >&2; exit 1; }; \
{{- end}}
{{- end}}
    done; \
    c="$(modprobe -c)"; \
{{- range $name, $m := .Modules}}
{{- if $m.Block}}
    { printf '%s\n' "$c" | grep -qxF 'blacklist {{$name}}' && printf '%s\n' "$c" | grep -qxF 'install {{$name}} /bin/false'; } || { echo "modprobe does not block {{$name}}" >&2; exit 1; }; \
{{- end}}
{{- if $m.Options}}
    printf '%s\n' "$c" | grep -qxF 'options {{$name}}{{range $k, $v := $m.Options}} {{$k}}={{$v}}{{end}}' || { echo "modprobe does not give {{$name}} its options" >&2; exit 1; }; \
{{- end}}
{{- if $m.Load}}
    systemd-analyze cat-config modules-load.d | grep -qx '{{$name}}' || { echo "systemd-modules-load does not load {{$name}}" >&2; exit 1; }; \
{{- end}}
{{- end}}
    true

{{end}}# Console on the screen and on the serial port, serial last so it owns /dev/console: the recovery
# shell must work on a VM without a display. The build fails when kairos-init's boot arguments
# no longer read as expected.
RUN set -e; f=/etc/cos/bootargs.cfg; \
    grep -qF 'set baseExtraConsole="console=ttyS0"' "$f"; \
    grep -qF 'set baseCmd="console=tty1 ' "$f"; \
    sed -i 's/set baseExtraConsole="console=ttyS0"/set baseExtraConsole="console=tty1 console=ttyS0,115200"/' "$f"; \
    sed -i 's/set baseCmd="console=tty1 /set baseCmd="/' "$f"; \
    grep -qF 'set baseExtraConsole="console=tty1 console=ttyS0,115200"' "$f"; \
    ! grep -qE 'set baseCmd=.*console=' "$f"

{{with .KernelArgs}}# The project's kernel arguments (host.kernel_args), after Kairos's own: the image's boot script
# gives them, so the active and passive systems each boot with their release's, and the recovery
# system (COS_SYSTEM, or a recovery image's label set) without them. The build fails when the
# script no longer ends by computing the command line.
RUN set -e; f=/etc/cos/bootargs.cfg; \
    [ "$(tail -n1 "$f")" = setKernelCmd ] || { echo "$f no longer ends with setKernelCmd" >&2; exit 1; }; \
{{- range $k, $_ := .}}
    ! grep -E '^[[:space:]]*set (baseCmd|baseRootCmd|baseSelinuxCmd|baseExtraConsole)=' "$f" | grep -qE '[" ]{{$k}}(=|[" ])' || { echo "host.kernel_args.{{$k}}: Kairos's boot sets it ($f)" >&2; exit 1; }; \
{{- end}}
    printf '%s\n' 'if test "${label}" != "COS_SYSTEM"; then if [ -z "$recoverylabel" ]; then set kernelcmd="$kernelcmd{{range $k, $v := .}} {{$k}}{{with $v.Value}}={{.}}{{end}}{{end}}"; fi; fi' >> "$f"

{{end}}# Kairos's boot stage sets a fixed receive buffer ceiling after the tune units have run, below the
# one they size from RAM: its line goes, the stage's other settings stay. The build fails when the
# line is no longer there to remove.
RUN set -e; f=/system/oem/09_systemd_services.yaml; \
    grep -qxF '        net.core.rmem_max: 7500000' "$f"; \
    sed -i '/^        net\.core\.rmem_max: 7500000$/d' "$f"; \
    if grep -q 'rmem_max' "$f"; then echo "shapes.kairos.kairos_init: its $f sets rmem_max elsewhere: use kairos-init v4.6.0" >&2; exit 1; fi; \
    grep -qF 'vm.max_map_count: 262144' "$f"

# The same stage enables iscsid, which the purge of open-iscsi removed (unless host.packages
# brings it back): every boot would log the enable's failure. The build fails when the stage no
# longer enables it, or still does without the unit.
RUN set -e; f=/system/oem/09_systemd_services.yaml; \
    grep -qxF '          - iscsid' "$f"; \
    u=; for d in /usr/lib /lib /etc; do [ ! -e "$d/systemd/system/iscsid.service" ] || u=1; done; \
    if [ -z "$u" ]; then \
        sed -i '/^          - iscsid$/d' "$f"; ! grep -q iscsid "$f"; fi

# Kairos's datasource stage pulls a cloud's user data from the providers it lists, which leave out
# Scaleway's metadata service (its datasource, yip's, reads the `cloud-init` user data): it is added
# last, probed beside the other clouds'. The build fails when the list no longer reads as expected.
RUN set -e; f=/system/oem/00_datasource.yaml; \
    [ "$(grep -cE '^ +providers: \[.*\]$' "$f")" = 1 ]; \
    if grep -q scaleway "$f"; then echo "shapes.kairos.kairos_init: its $f names scaleway already: use kairos-init v4.6.0" >&2; exit 1; fi; \
    sed -i -E 's/^( +providers: \[.*)\]$/\1, "scaleway"]/' "$f"; \
    grep -qE '^ +providers: \[.*"maas", "scaleway"\]$' "$f"

# Kairos's sysext stage enables systemd-sysext and systemd-confext at every boot, which merge any
# extension image found on the disk over /usr and /etc: a way to change the system outside the OS
# bundle, its digest and its A/B rollback, which the bundle never uses. Its enabling steps (the
# file's last 18 lines in kairos-init v4.6.0, by their sha256) go, and the booted system's units
# (every systemd-sysext and systemd-confext unit of its systemd, and systemd-sysext and
# systemd-confext's .service, .socket and @.service whether or not this systemd ships them) are
# masked in /usr, which leaves with the image: a
# mask in /etc would outlive a rollback in Kairos's persistent /etc/systemd, where an earlier
# bundle's boot enables them. The initrd's own units (systemd-sysext-initrd, systemd-confext-initrd)
# are left to the initrd, whose merge reaches the initrd alone.
# The build fails when the file no longer ends with those lines, or a unit is left unmasked.
RUN set -e; f=/system/oem/99_sysext.yaml; \
    n="$(grep -n '^    # systemd ships systemd-sysext.service from v248 and$' "$f" | cut -d: -f1)"; \
    [ "$(printf '%s\n' "$n" | wc -l)" = 1 ] && [ -n "$n" ] && [ "$(($(wc -l < "$f") - n + 1))" = 18 ] && \
        [ "$(tail -n +"$n" "$f" | sha256sum | cut -d' ' -f1)" = 6e0d2e85158d5235cf3163f525fa333f3cf613abf32236aaa12091863bbc77ce ] || \
        { echo "shapes.kairos.kairos_init: its $f does not end with the steps enabling systemd-sysext and systemd-confext the bundle removes: use kairos-init v4.6.0" >&2; exit 1; }; \
    head -n "$((n - 1))" "$f" > "$f.new"; cat "$f.new" > "$f"; rm "$f.new"; \
    if grep -qE '^ +(systemctl|enable):' "$f"; then echo "shapes.kairos.kairos_init: its $f enables a unit before the steps the bundle removes: use kairos-init v4.6.0" >&2; exit 1; fi; \
    units="systemd-sysext.service systemd-sysext.socket systemd-sysext@.service systemd-confext.service systemd-confext.socket systemd-confext@.service"; \
    for p in /usr/lib/systemd/system/systemd-sysext* /usr/lib/systemd/system/systemd-confext*; do \
        [ -e "$p" ] || [ -L "$p" ] || continue; [ ! -d "$p" ] || continue; u="${p##*/}"; \
        case "$u" in *-initrd.service) ;; *) case " $units " in *" $u "*) ;; *) units="$units $u";; esac;; esac; done; \
    for u in $units; do ln -sfn /dev/null "/usr/lib/systemd/system/$u"; done; \
    for u in $units; do [ "$(systemctl is-enabled "$u" 2>/dev/null || true)" = masked ] || \
        { o="$(ls -d /etc/systemd/system/"$u" /etc/systemd/system.control/"$u" /run/systemd/system/"$u" /usr/local/lib/systemd/system/"$u" 2>/dev/null | tr '\n' ' ')"; \
          echo "$u is not masked ($(systemctl is-enabled "$u" 2>&1)): ${o:-no file }overrides /usr/lib's mask, of the package(s) $(for x in $o; do dpkg -S "$x" 2>/dev/null | cut -d: -f1; done | sort -u | tr '\n' ' ')(none: written by a build step); host.packages, the base or a kairos-init other than v4.6.0 brings it" >&2; exit 1; }; done

# The locale every login's PAM reads: Ubuntu's /etc/default/locale is a link to /etc/locale.conf,
# which the base image lacks, so each SSH session and sudo would log the missing file. The build
# fails when the file does not read after.
RUN set -e; if [ ! -e /etc/default/locale ]; then \
        if [ -L /etc/default/locale ]; then t="$(readlink -f /etc/default/locale)"; else t=/etc/default/locale; fi; \
        printf 'LANG=C.UTF-8\n' > "$t"; fi; \
    grep -q '^LANG=' /etc/default/locale

# The host's resolver file is resolved's list of servers, linked at every boot by the bundle's
# tmpfiles rule (files/etc/tmpfiles.d), which replaces resolved's own. The build fails when
# systemd-tmpfiles does not read it in place of resolved's, or resolved is not enabled to write that
# list.
RUN set -e; c="$(systemd-tmpfiles --cat-config | grep -E '^[^#]*[[:space:]]/etc/resolv\.conf([[:space:]]|$)' || true)"; \
    [ "$c" = 'L+ /etc/resolv.conf - - - - ../run/systemd/resolve/resolv.conf' ] || { printf 'the tmpfiles rules of /etc/resolv.conf are not the bundle'"'"'s alone:\n%s\n' "$c" >&2; exit 1; }; \
    [ "$(systemctl is-enabled systemd-resolved.service)" = enabled ] || { echo "systemd-resolved is not enabled: /etc/resolv.conf would link to nothing" >&2; exit 1; }

# Kairos's boot assessment, with the health gate as its judge: the bundle's copy of 08_grub.yaml
# (kairos-init's, its sum checked above) leaves out the step that marks every boot of the active
# system good (files/usr/share/NAME).
RUN set -e; f=/system/oem/08_grub.yaml; \
    mv /usr/share/{{.Name}}/08_grub.yaml "$f"; \
    rmdir /usr/share/{{.Name}}; \
    ! grep -q 'Remove GRUB sentinels' "$f"

# The build fails when a package of the bundle's own boot or a declared one is not installed, a
# timer is not masked, or grub2-editenv (kairos-init's link to GRUB's), which the health gate
# writes the boot assessment with, is not there.
RUN set -e; command -v grub2-editenv >/dev/null || { echo "the OS bundle has no grub2-editenv, which the health gate writes the boot assessment with: use kairos-init v4.6.0" >&2; exit 1; }; \
    for p in{{range .Own}} {{.}}{{end}}; do \
        dpkg-query -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null | grep -q '^ii' || { echo "the OS bundle lacks $p, a package of its own" >&2; exit 1; }; done; \
{{- range $n, $_ := .Packages}}
    dpkg-query -W -f='${db:Status-Abbrev}' {{$n}} 2>/dev/null | grep -q '^ii' || { echo "host.packages.{{$n}}: not installed" >&2; exit 1; }; \
{{- end}}
    for u in apt-daily.timer apt-daily-upgrade.timer motd-news.timer; do [ "$(readlink /etc/systemd/system/$u)" = /dev/null ] || { echo "$u is not masked" >&2; exit 1; }; done

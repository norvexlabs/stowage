# syntax=docker/dockerfile:1
#
# The OS bundle of {{.Name}}: a plain distribution converted into a bootable Kairos image by
# kairos-init (no Kubernetes provider), with Docker running the stack and the release's images
# preloaded. Rendered and built by `stowage ship`.
{{/* purge removes the packages of the list that are installed: one kairos-init no longer installs
is absent already, and apt refuses a name it does not know. */}}{{define "purge"}}p="$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n'{{range .}} {{.}}{{end}} 2>/dev/null | awk '$1 ~ /^i/ {print $2}')"; \
    [ -z "$p" ] || apt-get purge -y $p{{end}}

FROM {{.KairosInit}} AS kairos-init

FROM {{.Base}}

# The build takes Ubuntu alone: its package names, Docker's repository and the purge below are
# Ubuntu's. Guest agents: kairos-init only starts them, on the hypervisor its DMI check matches.
# tzdata-legacy (the zones' old names, e.g. US/Eastern) where the base has it.
RUN . /etc/os-release && { [ "$ID" = ubuntu ] || { echo "shapes.kairos.base: $PRETTY_NAME: the OS bundle's build takes Ubuntu" >&2; exit 1; }; } \
    && apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl ethtool gnupg jq nftables open-vm-tools qemu-guest-agent tzdata \
        $(apt-cache show tzdata-legacy >/dev/null 2>&1 && echo tzdata-legacy) \
    && rm -rf /var/lib/apt/lists/*

# The install stage writes the version nowhere (the init stage does, below): a fixed one keeps this
# layer, and Docker's after it, cached from one release to the next.
COPY --from=kairos-init /kairos-init /kairos-init
RUN /kairos-init -s install -v 0.0.0

{{with .PurgeBeforeInit}}# kairos-init installs one package list on every Debian-family image; what the bundle does without
# goes before its init stage, so the initrd that stage builds carries none of it. multipath-tools
# stays: the init stage adds dracut's multipath module, which needs it (its daemon is masked).
RUN {{template "purge" .}}; \
    apt-get autoremove -y --purge

{{end}}# Docker engine and the compose plugin, from Docker's apt repository.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && . /etc/os-release \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu ${VERSION_CODENAME} stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Docker keeps its data on the persistent partition (/usr/local), so images and containers survive
# an A/B upgrade, and starts after nftables, whose ruleset flush would drop Docker's chains.
RUN mkdir -p /etc/docker /etc/systemd/system/docker.service.d \
    && printf '{\n  "data-root": "/usr/local/docker",\n  "features": {"containerd-snapshotter": true}\n}\n' > /etc/docker/daemon.json \
    && printf '[Unit]\nAfter=nftables.service\nWants=nftables.service\n' > /etc/systemd/system/docker.service.d/after-nftables.conf

# Everything the image adds lives outside /usr/local, /var, /oem, /opt and /home: Kairos mounts
# persistent storage there, which would hide it.
COPY files/ /
RUN chmod 0440 /etc/sudoers.d/10-{{.Name}} \
    && chmod 0755 /usr/sbin/{{.Name}}-preload \
    && mkdir -p /etc/{{.Name}} \
    && echo "{{.OSVersion}}" > /etc/{{.Name}}/os-version \
    && mkdir -p /etc/systemd/system/multi-user.target.wants /etc/systemd/system/getty.target.wants \
    && (getent group admin >/dev/null || groupadd --system admin) \
    && for u in {{.Name}}-expand.service {{.Name}}-preload.service {{.Name}}.service {{.Name}}-health.service {{.Name}}-hostd.service {{.Name}}-network.service {{.Name}}-tune.service {{.Name}}-tune-online.service; do \
           ln -sf /etc/systemd/system/$u /etc/systemd/system/multi-user.target.wants/$u; done \
    && ln -sf /lib/systemd/system/docker.service /etc/systemd/system/multi-user.target.wants/docker.service \
    && ln -sf /lib/systemd/system/nftables.service /etc/systemd/system/multi-user.target.wants/nftables.service \
    && ln -sf /lib/systemd/system/serial-getty@.service /etc/systemd/system/getty.target.wants/serial-getty@ttyS0.service \
    && ln -sf /usr/lib/systemd/system/open-vm-tools.service /etc/systemd/system/vmtoolsd.service \
    && ln -sf /dev/null /etc/systemd/system/multipathd.service

# The release's images, as archives `docker load` reads at every boot.
COPY preload/ /usr/share/{{.Name}}-preload/

# {{.Ctl}}, carrying the release: it installs it, brings it up at every boot and runs the host
# daemon.
COPY --chmod=0755 ctl/{{.Ctl}} /usr/sbin/{{.Ctl}}

# kairos-init's init stage strips the kernel modules; without them netfilter, and so nftables and
# Docker, fail. They are reinstalled, and the build fails if they did not come back. Its CIS
# hardening step is skipped: its shell umask (027) would leave the files an operator's run
# writes unreadable to a stack's non-root containers, and its password ageing and lockout apply
# to the operator's account. Its SSH hardening stays; the build fails without its drop-in. The
# drop-in moves to this image's /usr, read through an Include: /etc/ssh is persistent state,
# which every boot fills from its image without deleting, so a file left there by a newer image
# would reach an older one's sshd on a rollback, which refuses settings it does not know and
# does not start. On a system without that directory the Include reads nothing. The build fails
# when sshd's effective settings are not the drop-in's.
RUN set -e \
    && /kairos-init -s init --skip-step cisHardening -v "{{.OSVersion}}" \
    && rm /kairos-init \
    && grep -qx 'AllowTcpForwarding no' /etc/ssh/sshd_config.d/05-kairos-hardening.conf \
    && install -d -m 0755 /usr/lib/{{.Name}}/sshd_config.d \
    && mv /etc/ssh/sshd_config.d/05-kairos-hardening.conf /usr/lib/{{.Name}}/sshd_config.d/ \
    && printf 'Include /usr/lib/{{.Name}}/sshd_config.d/*.conf\n' > /etc/ssh/sshd_config.d/00-{{.Name}}-hardening.conf \
    && k="$(mktemp -d)" && ssh-keygen -q -t ed25519 -N '' -f "$k/key" && mkdir -p /run/sshd \
    && sshd -T -h "$k/key" > "$k/effective" \
    && grep -qx 'allowtcpforwarding no' "$k/effective" && grep -qx 'maxauthtries 4' "$k/effective" \
    && rm -rf "$k" \
    && ! test -e /etc/modprobe.d/cis-blocklist.conf \
    && ! grep -rqsE '^[[:space:]]*umask[[:space:]]+0*27([^0-7]|$)' /etc/profile /etc/profile.d /etc/bash.bashrc \
    && ! grep -qsE '^[[:space:]]*UMASK[[:space:]]+0*27([^0-7]|$)' /etc/login.defs \
    && mods="$(dpkg-query -W -f='${Package}\n' 'linux-modules-*' 2>/dev/null | sort -u)" \
    && if [ -z "$mods" ]; then echo "no linux-modules-* package installed" >&2; exit 1; fi \
    && apt-get update \
    && apt-get install --reinstall -y --no-install-recommends $mods \
    && rm -rf /var/lib/apt/lists/* \
    && n=$(find /lib/modules/ -name '*.ko*' | wc -l) \
    && if [ "$n" -lt 100 ]; then echo "only $n kernel modules after the reinstall" >&2; exit 1; fi

# What goes after the init stage: the packages it enables unconditionally, and the timers that
# would upgrade an image-based system in place or fetch Canonical's news (masked). The build fails
# when a purged package is still installed (but those host.packages declares). The project's
# packages (host.packages) come last, after the stage that would strip a kernel module they ship,
# with what they depend on (a purged one included), over the image as the init stage built its
# initrd: the packages the boot and the stack run on are held (those not held already), so apt
# neither upgrades nor removes one for them (one that needs it fails the build), and the build
# fails when they bring a package of that kind (a kernel, its modules, a service of the boot's);
# one declared that is installed already is left as it is.
RUN set -e{{with .PurgeAfterInit}}; {{template "purge" .}}{{end}}; \
    for u in apt-daily.timer apt-daily-upgrade.timer motd-news.timer; do ln -sf /dev/null /etc/systemd/system/$u; done; \
    for p in{{range .Absent}} {{.}}{{end}}; do \
        if dpkg-query -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null | grep -q '^i'; then echo "the OS bundle has $p, which it purges: host.packages keeps one" >&2; exit 1; fi; done{{with .Packages}}; \
    t="$(mktemp -d)"; dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' | awk '$1 ~ /^i/ {print $2}' > "$t/installed"; \
    apt-mark showhold > "$t/held"; \
    held="$(grep -E '{{$.Held}}' "$t/installed" | grep -vxF -f "$t/held" || true)"; \
    want="$(printf '%s\n'{{range $n, $_ := .}} {{$n}}{{end}} | grep -vxF -f "$t/installed" || true)"; \
    [ -z "$held" ] || printf '%s\n' "$held" | xargs apt-mark hold >/dev/null; \
    if [ -n "$want" ]; then apt-get update; apt-get install -y --no-install-recommends --no-remove $want; fi; \
    new="$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' | awk '$1 ~ /^i/ {print $2}' | grep -E '{{$.Held}}' | grep -vxF -f "$t/installed" || true)"; rm -rf "$t"; \
    [ -z "$new" ] || { echo "host.packages bring packages of the boot's own: $new" >&2; exit 1; }; \
    [ -z "$held" ] || printf '%s\n' "$held" | xargs apt-mark unhold >/dev/null; \
    rm -rf /var/lib/apt/lists/*{{end}}

# The clouds' fast NICs, gVNIC (gve) and Azure's MANA, ship in the kernel's extra modules: those two
# are copied from it, not its 110 MB. The build fails when a kernel lacks one, a module the boot's
# tuning loads (TUN devices, the connection tracker, BBR, fq), a server's NIC or disk controller
# a bare-metal install boots with (Intel, Broadcom, Mellanox, Marvell/QLogic, Realtek, NVMe, AHCI,
# LSI/Broadcom MegaRAID and SAS, Microchip, HPE).
RUN set -e; apt-get update; cd /tmp; \
    for k in /lib/modules/*; do v="$(basename "$k")"; \
        if ! modinfo -k "$v" gve >/dev/null 2>&1 || ! modinfo -k "$v" mana >/dev/null 2>&1; then \
            apt-get download "linux-modules-extra-$v"; dpkg-deb -x linux-modules-extra-"$v"_*.deb /tmp/extra; \
            for m in gve mana; do \
                f="$(find /tmp/extra -path "*/modules/$v/*" -name "$m.ko*" | head -n1)"; \
                if [ -z "$f" ]; then echo "linux-modules-extra-$v has no $m" >&2; exit 1; fi; \
                install -D -m 0644 "$f" "$k/${f#*/modules/$v/}"; done; \
            rm -rf /tmp/extra linux-modules-extra-*.deb; depmod "$v"; fi; \
        for m in tun nf_conntrack tcp_bbr sch_fq gve mana mlx5_core \
            ice i40e ixgbe igb igc e1000e bnxt_en mlx4_en tg3 qede r8169 nvme ahci megaraid_sas mpt3sas smartpqi hpsa; do \
            modinfo -k "$v" "$m" >/dev/null || { echo "kernel $v lacks $m" >&2; exit 1; }; done; done; \
    rm -rf /var/lib/apt/lists/*

{{with .Firmware}}# The firmware files the project's drivers load (host.firmware). The build fails when one is not
# under /lib/firmware, as it is or compressed.
RUN set -e; for f in{{range $p, $_ := .}} {{$p}}{{end}}; do \
        [ -f "/lib/firmware/$f" ] || [ -f "/lib/firmware/$f.zst" ] || [ -f "/lib/firmware/$f.xz" ] || \
            { echo "host.firmware.$f: the OS bundle has no /lib/firmware/$f (nor .zst, .xz): host.packages gives the package that ships it" >&2; exit 1; }; done

{{end}}{{if .Modules}}# The project's kernel modules (host.modules). The build fails when a module to load or
# give options is in no kernel, when one is built into it (modprobe's files do not reach those,
# and tune could not tell one loaded), when an option is not one of the module's parameters, or when
# modprobe does not read the bundle's files.
RUN set -e; for k in /lib/modules/*; do v="$(basename "$k")"; \
{{- range $name, $m := .Modules}}
{{- if or $m.Load $m.Options}}
        modinfo -k "$v" {{$name}} >/dev/null || { echo "host.modules.{{$name}}: kernel $v has no such module" >&2; exit 1; }; \
{{- end}}
        [ "$(modinfo -k "$v" -F filename {{$name}} 2>/dev/null)" != "(builtin)" ] || { echo "host.modules.{{$name}}: built into kernel $v: modprobe's files do not reach it, and it is always there" >&2; exit 1; }; \
{{- range $o, $_ := $m.Options}}
        modinfo -k "$v" -F parm {{$name}} | cut -d: -f1 | grep -qx {{$o}} || { echo "host.modules.{{$name}}.options: {{$o}} is not a parameter of kernel $v's {{$name}}" >&2; exit 1; }; \
{{- end}}
{{- end}}
    done; \
    c="$(modprobe -c)"; \
{{- range $name, $m := .Modules}}
{{- if $m.Block}}
    { printf '%s\n' "$c" | grep -qxF 'blacklist {{$name}}' && printf '%s\n' "$c" | grep -qxF 'install {{$name}} /bin/false'; } || { echo "modprobe does not block {{$name}}" >&2; exit 1; }; \
{{- end}}
{{- if $m.Options}}
    printf '%s\n' "$c" | grep -qxF 'options {{$name}}{{range $k, $v := $m.Options}} {{$k}}={{$v}}{{end}}' || { echo "modprobe does not give {{$name}} its options" >&2; exit 1; }; \
{{- end}}
{{- if $m.Load}}
    systemd-analyze cat-config modules-load.d | grep -qx '{{$name}}' || { echo "systemd-modules-load does not load {{$name}}" >&2; exit 1; }; \
{{- end}}
{{- end}}
    true

{{end}}# Console on the screen and on the serial port, serial last so it owns /dev/console: the recovery
# shell must work on a VM without a display. The build fails when kairos-init's boot arguments
# no longer read as expected.
RUN set -e; f=/etc/cos/bootargs.cfg; \
    grep -qF 'set baseExtraConsole="console=ttyS0"' "$f"; \
    grep -qF 'set baseCmd="console=tty1 ' "$f"; \
    sed -i 's/set baseExtraConsole="console=ttyS0"/set baseExtraConsole="console=tty1 console=ttyS0,115200"/' "$f"; \
    sed -i 's/set baseCmd="console=tty1 /set baseCmd="/' "$f"; \
    grep -qF 'set baseExtraConsole="console=tty1 console=ttyS0,115200"' "$f"; \
    ! grep -qE 'set baseCmd=.*console=' "$f"

{{with .KernelArgs}}# The project's kernel arguments (host.kernel_args), after Kairos's own: the image's boot script
# gives them, so the active and passive systems each boot with their release's, and the recovery
# system (COS_SYSTEM, or a recovery image's label set) without them. The build fails when the
# script no longer ends by computing the command line.
RUN set -e; f=/etc/cos/bootargs.cfg; \
    [ "$(tail -n1 "$f")" = setKernelCmd ] || { echo "$f no longer ends with setKernelCmd" >&2; exit 1; }; \
{{- range $k, $_ := .}}
    ! grep -E '^[[:space:]]*set (baseCmd|baseRootCmd|baseSelinuxCmd|baseExtraConsole)=' "$f" | grep -qE '[" ]{{$k}}(=|[" ])' || { echo "host.kernel_args.{{$k}}: Kairos's boot sets it ($f)" >&2; exit 1; }; \
{{- end}}
    printf '%s\n' 'if test "${label}" != "COS_SYSTEM"; then if [ -z "$recoverylabel" ]; then set kernelcmd="$kernelcmd{{range $k, $v := .}} {{$k}}{{with $v.Value}}={{.}}{{end}}{{end}}"; fi; fi' >> "$f"

{{end}}# Kairos's boot stage sets a fixed receive buffer ceiling after the tune units have run, below the
# one they size from RAM: its line goes, the stage's other settings stay. The build fails when the
# line is no longer there to remove.
RUN set -e; f=/system/oem/09_systemd_services.yaml; \
    grep -qxF '        net.core.rmem_max: 7500000' "$f"; \
    sed -i '/^        net\.core\.rmem_max: 7500000$/d' "$f"; \
    ! grep -q 'rmem_max' "$f"; \
    grep -qF 'vm.max_map_count: 262144' "$f"

# Kairos's boot assessment, with the health gate as its judge: the bundle's copy of 08_grub.yaml
# leaves out the step that marks every boot of the active system good (files/usr/share/NAME). The
# build fails when kairos-init's file is no longer the one that copy is derived from, naming the
# release it is derived from.
RUN set -e; f=/system/oem/08_grub.yaml; \
    echo "25f60229d81892d0ddd437d8f880a4fc92668fd0e8ddcb8a88e26e4c5a04d7e2  $f" | sha256sum -c - || \
        { echo "shapes.kairos.kairos_init: its $f is not the one this stowage's boot assessment is derived from: use kairos-init v4.4.0-rc2" >&2; exit 1; }; \
    mv /usr/share/{{.Name}}/08_grub.yaml "$f"; \
    rmdir /usr/share/{{.Name}}; \
    ! grep -q 'Remove GRUB sentinels' "$f"

# The build fails when a package of the bundle's own boot or a declared one is not installed, or a
# timer is not masked.
RUN set -e; for p in{{range .Own}} {{.}}{{end}}; do \
        dpkg-query -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null | grep -q '^ii' || { echo "the OS bundle lacks $p, a package of its own" >&2; exit 1; }; done; \
{{- range $n, $_ := .Packages}}
    dpkg-query -W -f='${db:Status-Abbrev}' {{$n}} 2>/dev/null | grep -q '^ii' || { echo "host.packages.{{$n}}: not installed" >&2; exit 1; }; \
{{- end}}
    for u in apt-daily.timer apt-daily-upgrade.timer motd-news.timer; do [ "$(readlink /etc/systemd/system/$u)" = /dev/null ] || { echo "$u is not masked" >&2; exit 1; }; done

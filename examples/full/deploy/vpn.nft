# The vpn service's own table (services.vpn.nftables): what reaches the host from vpn0 goes to
# the service's transparent sockets on 17008, its destination kept (services.vpn.transparent).
table inet vpn {
	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		iifname "vpn0" meta l4proto { tcp, udp } tproxy to :17008 meta mark set 0x1 accept
	}
}

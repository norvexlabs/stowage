#!/bin/sh
# Refuses a message that names an AI as an author of the change.
set -eu
if grep -Eiq '^(co-authored-by|generated-by):.*(claude|anthropic|openai|copilot|gpt|gemini)|generated with \[?claude|written by (claude|opus|sonnet)' "$1"; then
  echo "commit-msg: the message names an AI as an author; remove that line" >&2
  exit 1
fi
